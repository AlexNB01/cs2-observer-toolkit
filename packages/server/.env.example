PORT=3001
WEB_ORIGIN=http://localhost:5173

# Optional one-time seed for CS2's game/csgo/cfg folder — only used the
# first time hud_settings is created. Normally set (and changed) from the
# GSI Setup page in the app itself instead.
# Example: C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo\cfg
CS2_CFG_DIR=

# Optional one-time seed for HLAE.exe (get it yourself from https://www.hlae.online/
# — not downloaded/installed by this app). Normally set (and changed) from the
# HLAE page in the app itself instead.
# Example: C:\HLAE\HLAE.exe
HLAE_EXE_PATH=
