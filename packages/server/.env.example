PORT=3001
WEB_ORIGIN=http://localhost:5173

# Optional: absolute path to CS2's game/csgo/cfg folder. Set this to enable
# "Install GSI config" from the admin panel (section 1 of the spec).
# Example: C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo\cfg
CS2_CFG_DIR=

# Optional: absolute path to HLAE.exe (get it yourself from https://www.hlae.online/ —
# not downloaded/installed by this app). Enables the "Launch HLAE" button in section 12.
# Example: C:\HLAE\HLAE.exe
HLAE_EXE_PATH=

# Optional: Faceit Data API key (https://developers.faceit.com/apps), needed for
# "Import a match" from a faceit.com/.../room/... URL in the veto section.
FACEIT_API_KEY=
